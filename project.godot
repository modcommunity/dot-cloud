; dot-cloud — runtime content delivery for Godot.
;
; The distributable is `addons/dot_cloud/`. This project exists so the addon can
; be opened and validated standalone.
;
; `addons/dot_core/` is a LOCAL SYMLINK to ../dot-core/addons/dot_core and is
; gitignored — dot-core is a separate repository. See CLAUDE.md.

config_version=5

[application]

config/name="dot-cloud"
config/description="Runtime content delivery: manifests, content-addressed cache, resumable downloads, and namespaced pack mounting."
config/version="0.1.0"
run/main_scene="res://examples/sync_demo.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/dot_core/plugin.cfg", "res://addons/dot_cloud/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
